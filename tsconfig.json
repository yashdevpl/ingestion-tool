{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler", // <--- important
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true, // optional but helps with type errors
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx" // if using React
  }
}
